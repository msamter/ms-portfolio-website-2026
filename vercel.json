{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/work",
      "destination": "/Work",
      "permanent": true
    },
    {
      "source": "/work/wellbe",
      "destination": "/Work",
      "permanent": true
    },
    {
      "source": "/work/holistic-mental-health",
      "destination": "/Work",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_vercel/|assets/|fonts/|robots\\.txt|sitemap\\.xml|site\\.webmanifest|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
